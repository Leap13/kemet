{
    "$schema": "https://schemas.wp.org/wp/6.7/theme.json",
    "version": 3,
    "title": "Dark",
    "slug": "dark",
    "settings": {
        "color": {
            "palette": [
                {
                    "slug": "foreground",
                    "color": "#f7f7f7",
                    "name": "Foreground"
                },
                {
                    "slug": "background",
                    "color": "#3b3b3b",
                    "name": "Background"
                },
                {
                    "slug": "primary",
                    "color": "#f67206",
                    "name": "Primary"
                },
                {
                    "slug": "secondary",
                    "color": "#fcfcfc",
                    "name": "Secondary"
                },
                {
                    "slug": "tertiary",
                    "color": "#2c2c2c",
                    "name": "Tertiary"
                }
            ]
        }
    },
    "styles": {
        "color": {
            "text": "var(--wp--preset--color--secondary)",
            "background": "var(--wp--preset--color--background)"
        },
        "typography": {
            "fontFamily": "var(--wp--preset--font-family--lato)",
            "fontSize": "var(--wp--preset--font-size--normal)",
            "fontWeight": "300",
            "lineHeight": "1.7"
        },
        "spacing": {
            "padding": {
                "top": "25px",
                "bottom": "25px",
                "left": "25px",
                "right": "25px"
            }
        },
        "elements": {
            "h1": {
                "color": {
                    "text": "var(--wp--preset--color--foreground)"
                },
                "typography": {
                    "fontFamily": "var(--wp--preset--font-family--lato)",
                    "fontWeight": "700"
                }
            },
            "h2": {
                "color": {
                    "text": "var(--wp--preset--color--foreground)"
                },
                "typography": {
                    "fontFamily": "var(--wp--preset--font-family--lato)",
                    "fontWeight": "600"
                }
            },
            "h3": {
                "color": {
                    "text": "var(--wp--preset--color--foreground)"
                },
                "typography": {
                    "fontFamily": "var(--wp--preset--font-family--lato)",
                    "fontWeight": "500"
                }
            },
            "link": {
                "color": {
                    "text": "var(--wp--preset--color--primary)"
                },
                "typography": {
                    "textDecoration": "none"
                }
            }
        }
    }
}
